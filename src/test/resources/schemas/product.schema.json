{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "integer" },
    "title": { "type": "string", "minLength": 1 },
    "price": { "type": ["number", "integer"] },
    "stock": { "type": "integer" },
    "category": { "type": "string" }
  }
}
